        </mxCell>
        <mxCell id="lg0t" value="Los datos raw / curated llegan a &lt;b&gt;Amazon S3&lt;/b&gt;; &lt;b&gt;AWS Glue&lt;/b&gt; los cataloga (crawler) y valida con Data Quality." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="72" y="1110" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg1n" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="650" y="1118" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg1t" value="Argo Workflows, en nodos EC2 de &lt;b&gt;Amazon EKS&lt;/b&gt;, lee el dataset de S3 por el &lt;b&gt;VPC endpoint gateway&lt;/b&gt;, con un rol &lt;b&gt;IAM&lt;/b&gt; vía IRSA." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="682" y="1110" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg2n" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1118" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg2t" value="Validación (Great Expectations) y entrenamiento (scikit-learn) en nodos CPU / GPU; features desde Feast." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1292" y="1110" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg3n" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1164" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg3t" value="Métricas, modelo y versión se registran en MLflow; PostgreSQL y MinIO persisten en &lt;b&gt;Amazon EBS&lt;/b&gt; y las credenciales vienen de &lt;b&gt;Secrets Manager&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="72" y="1156" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg4n" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="650" y="1164" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg4t" value="BuildKit construye la imagen del modelo aprobado y la publica en &lt;b&gt;Amazon ECR&lt;/b&gt; por los &lt;b&gt;VPC endpoints&lt;/b&gt; de ECR." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="682" y="1156" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg5n" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1164" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg5t" value="KServe descarga la imagen de ECR (rol IAM de los nodos) y despliega el InferenceService en modo canary." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1292" y="1156" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg6n" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1210" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg6t" value="El consumidor llama al modelo: &lt;b&gt;Internet gateway&lt;/b&gt; → &lt;b&gt;Application Load Balancer&lt;/b&gt; → Istio ingress → KServe." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="72" y="1202" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg7n" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="650" y="1210" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg7t" value="Prometheus y Evidently miden latencia, performance y drift; Grafana y Alertmanager visualizan y alertan." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="682" y="1202" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg8n" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1210" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg8t" value="Ante drift o degradación se dispara el workflow de reentrenamiento en Argo y el ciclo vuelve al paso 2." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1292" y="1202" width="560" height="40" as="geometry" />
